import numpy as np
import matplotlib.pyplot as plt

# Step 1: Load ECG + PPG data
data = np.loadtxt(r"C:\Users\Dell\Downloads\preethidataLab.txt")

# Step 2: Sampling parameters
fs = 500
t = 1 / fs              # sample period

# ---- Step 3: Detect R-peaks in ECG ----
ecg = data[:, 0]
th = 0.75 * np.max(ecg)          # threshold for R-peaks
r = []
for i in range(1, len(ecg) - 1):
    if ecg[i] > th:                          # above threshold
        if ecg[i] > ecg[i-1] and ecg[i] > ecg[i+1]:   # local max
            r.append(i)

# ---- Step 4: Extract PPG segment (offset = 1000) ----
ppg = data[1000:2500, 1]

# ---- Step 5: Compute VPG (derivative of PPG) ----
vpg = np.zeros(len(ppg))
for i in range(1, len(ppg) - 1):
    vpg[i] = (ppg[i+1] - ppg[i-1]) / (2 * t)   # central difference

# ---- Step 6: Detect VPG peaks ----
th = 0.65 * np.max(vpg)          # threshold for VPG peaks
v = []
for i in range(1, len(vpg) - 1):
    if vpg[i] > th:
        if vpg[i] > vpg[i-1] and vpg[i] > vpg[i+1]:
            v.append(i)

# ---- Step 7: Debounce VPG peaks (keep peaks >0.3 s apart) ----
vp = []
for i in v:
    if len(vp) == 0 or i - vp[-1] > 0.3 * fs:
        vp.append(i)

# ---- Step 8: Find PPG foot (onset) for each VPG peak ----
# Walk backwards from VPG peak until VPG crosses zero upward
on = []
for i in vp:
    for j in range(i - 1, 0, -1):
        if vpg[j] <= 0 and vpg[j+1] > 0:      # rising zero-crossing
            on.append(j + 1000)               # add offset to get global index
            break

# ---- Step 9: Compute PAT (time from R-peak to foot) ----
pat = []
for i in r:
    for j in on:
        if j > i:                    # first foot after this R-peak
            pat.append((j - i) / fs) # convert samples to seconds
            break

pat = np.array(pat)

# ---- Step 10: Compute PTT (subtract fixed PEP) ----
pep = 0.075
ptt = pat - pep

# ---- Step 11: Estimate blood pressure ----
sbp = 80 + (8 / ptt)            # systolic BP
dbp = 40 + (8 / ptt)            # diastolic BP

print("PAT:", pat)
print("PTT:", ptt)
print("SBP:", np.mean(sbp))
print("DBP:", np.mean(dbp))

# ---- Step 12: Plot ECG, PPG, and VPG ----
plt.subplot(3, 1, 1)
plt.plot(ecg)
plt.title("ECG")

plt.subplot(3, 1, 2)
plt.plot(ppg)
plt.title("PPG")

plt.subplot(3, 1, 3)
plt.plot(vpg)
plt.plot(vp, vpg[vp], "ro")     # mark VPG peaks with red dots
plt.title("VPG")

plt.tight_layout()
plt.show()
